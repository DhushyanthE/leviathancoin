{
  "info": {
    "name": "Leviathan Blockchain API",
    "description": "API collection for Leviathan Blockchain Network",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/api",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "lv_live_YOUR_MASTER_KEY_HERE",
      "description": "Paste your master API key here. Generated on first server boot and printed to the console.",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "your-wallet-address-or-user-id",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "🔑 API Key Management",
      "description": "Endpoints for generating, validating, listing, and revoking API keys. All protected routes require an x-api-key header.",
      "item": [
        {
          "name": "List Available Scopes (Public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/keys/scopes",
            "description": "Returns all valid permission scopes and their descriptions. No auth required."
          }
        },
        {
          "name": "Validate Key (Echo Identity)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/keys/validate",
            "description": "Test that your API key is valid. Returns userId, scopes, rate-limit info."
          }
        },
        {
          "name": "Generate API Key (Master Required)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "url": "{{baseUrl}}/keys/generate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"label\": \"My CI Pipeline Key\",\n  \"scopes\": [\"dao:read\", \"staking:read\", \"mining:read\"],\n  \"rateLimit\": 100,\n  \"expiresInDays\": 90\n}"
            },
            "description": "Creates a new API key. The raw key is returned ONCE in the response — copy it immediately."
          }
        },
        {
          "name": "Generate Wildcard Key (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "url": "{{baseUrl}}/keys/generate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"label\": \"Admin Master Key\",\n  \"scopes\": [\"*\"],\n  \"rateLimit\": 1000,\n  \"expiresInDays\": null\n}"
            }
          }
        },
        {
          "name": "List Keys for User",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/keys/list/{{userId}}",
            "description": "Returns all key metadata (truncated identifiers, scopes, usage stats) for a userId. No raw keys."
          }
        },
        {
          "name": "List All Keys (Admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/keys/admin/all",
            "description": "Returns all keys in the system. Requires wildcard (*) scope."
          }
        },
        {
          "name": "Revoke a Key",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/keys/KEY_ID_HERE/revoke",
            "description": "Soft-revokes a key. The key becomes instantly invalid but its record is preserved."
          }
        },
        {
          "name": "Re-activate a Key (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/keys/KEY_ID_HERE/activate",
            "description": "Re-enables a previously revoked key. Requires wildcard scope."
          }
        }
      ]
    },
    {
      "name": "Wallet",
      "item": [
        {
          "name": "Generate Wallet",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/wallet/generate"
          }
        },
        {
          "name": "Get Balance",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/wallet/balance/:address"
          }
        },
        {
          "name": "Verify Mnemonic",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/wallet/verify",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mnemonic\": \"your 25 word mnemonic here\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Token",
      "item": [
        {
          "name": "Create Token (ASA)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/token/create",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mnemonic\": \"your 25 word mnemonic here\",\n  \"name\": \"Leviathan Coin\",\n  \"unitName\": \"LEVI\",\n  \"total\": 1000000,\n  \"decimals\": 6,\n  \"url\": \"https://leviathancoin.com\"\n}"
            }
          }
        },
        {
          "name": "Transfer Token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/token/transfer",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mnemonic\": \"your 25 word mnemonic here\",\n  \"assetId\": 123456,\n  \"to\": \"RECIPIENT_ADDRESS\",\n  \"amount\": 1000\n}"
            }
          }
        },
        {
          "name": "Opt-in to Token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/token/optin",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mnemonic\": \"your 25 word mnemonic here\",\n  \"assetId\": 123456\n}"
            }
          }
        },
        {
          "name": "Get Token Info",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/token/info/:assetId"
          }
        }
      ]
    },
    {
      "name": "NFT",
      "item": [
        {
          "name": "Create NFT",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/nft/create",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mnemonic\": \"your 25 word mnemonic here\",\n  \"name\": \"Leviathan NFT #1\",\n  \"unitName\": \"LEVI\",\n  \"url\": \"https://leviathancoin.com/nft/1\"\n}"
            }
          }
        },
        {
          "name": "Transfer NFT",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/nft/transfer",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mnemonic\": \"your 25 word mnemonic here\",\n  \"assetId\": 123456,\n  \"to\": \"RECIPIENT_ADDRESS\"\n}"
            }
          }
        },
        {
          "name": "Get NFT Info",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/nft/info/:assetId"
          }
        },
        {
          "name": "Get Owned NFTs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/nft/owned/:address"
          }
        },
        {
          "name": "Opt-in to NFT",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/nft/optin",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mnemonic\": \"your 25 word mnemonic here\",\n  \"assetId\": 123456\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Mining",
      "item": [
        {
          "name": "Mine Tokens",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/mining/mine",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mnemonic\": \"your 25 word mnemonic here\",\n  \"appId\": 0\n}"
            }
          }
        },
        {
          "name": "Get Mining Stats",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/mining/stats"
          }
        },
        {
          "name": "Get Leaderboard",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/mining/leaderboard"
          }
        },
        {
          "name": "Get Difficulty",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/mining/difficulty"
          }
        }
      ]
    }
  ]
}
