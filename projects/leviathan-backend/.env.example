# Leviathan Backend Environment Variables

# Server Configuration
PORT=3001
NODE_ENV=development

# Algorand Network (localnet, testnet, mainnet)
NETWORK=localnet

# Algorand Node Configuration
# For localnet: http://localhost:4001
# For testnet: https://testnet-api.algorand.network
# For mainnet: https://mainnet-api.algorand.network
ALGO_API_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
ALGO_INDEXER_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# RPC URLs
RPC_URL=http://localhost:4001
INDEXER_URL=http://localhost:4001

# Wallet Mnemonic (DEPLOYER)
# WARNING: Never commit this to version control!
DEPLOYER_MNEMONIC=

# Smart Contract Application ID (after deployment)
CONTRACT_APP_ID=

# Leviathan Token Asset ID
TOKEN_ASSET_ID=

# Security
QUANTUM_SECRET=your-quantum-secret-key-here
JWT_SECRET=your-jwt-secret-here

# API Key System
# These are auto-generated on first boot and printed to the console.
# Copy the values printed at startup into here to persist the master key across restarts.
MASTER_API_KEY_HASH=
MASTER_API_KEY_TRUNCATED=
# Per-key default rate limit (requests per minute)
API_KEY_DEFAULT_RATE_LIMIT=100

# Web3.Storage and thirdweb integration
WEB3_STORAGE_TOKEN=your_web3_storage_api_token
THIRDWEB_RPC_URL=https://eth-goerli.public-rpc.com
